@import "styles/theme.wxss";

page {
  min-height: 100vh;
  background: #faf8f4;
  color: #302e29;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0 !important;
  padding: 0;
  box-sizing: border-box;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
  text-align: inherit;
}
button::after {
  border: none;
}
.button-hover {
  opacity: 0.86;
}
