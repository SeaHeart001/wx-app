.welcome-art {
  margin-top: 68rpx;
  padding: 62rpx;
  text-align: center;
}
.leaf-icon {
  width: 123rpx;
  height: 123rpx;
}
.welcome-copy {
  display: block;
  margin-top: 23rpx;
  color: #35432d;
  font-size: 33rpx;
  font-weight: 700;
}
.welcome-eyebrow {
  margin-top: 38rpx;
}
.welcome-login {
  margin-top: 86rpx !important;
}
.avatar-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 38rpx;
}
.avatar-row .avatar {
  width: 138rpx !important;
  height: 138rpx;
  font-size: 46rpx;
  padding: 0;
  line-height: 1;
}
.heart-icon {
  display: block;
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
}
.names-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 23rpx;
  font-size: 27rpx;
}
.names-row text {
  max-width: 48%;
  overflow-wrap: break-word;
}
.connection-status {
  display: block;
  margin-top: 23rpx;
  font-size: 23rpx;
  color: #687a53;
}
.empty-title {
  margin: 23rpx 0;
}
.find-button {
  margin-top: 23rpx !important;
}
.interaction-head {
  display: flex;
  gap: 23rpx;
  align-items: flex-start;
  margin-bottom: 23rpx;
}
.hand-icon {
  display: block;
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
}
.interaction-copy {
  min-width: 0;
  flex: 1;
}
.interaction-copy .copy {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.interaction-card .primary-button + .primary-button {
  margin-top: 23rpx !important;
}
.change-binding {
  margin-top: 20rpx !important;
}
.search-row {
  display: flex;
  gap: 20rpx;
  margin-top: 38rpx;
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 31rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  font-size: 29rpx;
  color: #302e29;
}
.search-button {
  width: 76rpx !important;
  flex: 0 0 auto;
  color: #687a53;
  padding: 8rpx;
  font-size: 27rpx;
}
.account-row {
  display: flex;
  align-items: center;
  gap: 27rpx;
  margin-bottom: 27rpx;
}
.account-info {
  flex: 1;
  min-width: 0;
}
.account-id {
  font-size: 21rpx;
  word-break: break-all;
  margin-top: 6rpx;
}
.invitation-card {
  margin-top: 76rpx;
  text-align: center;
}
.check-icon {
  width: 85rpx;
  height: 85rpx;
}
.invitation-avatar {
  width: 154rpx;
  height: 154rpx;
  margin: 23rpx auto 0;
}
.invitation-title {
  display: block;
  margin-top: 23rpx;
  color: #35432d;
  font-size: 46rpx;
  font-weight: 700;
}
.invitation-copy {
  display: block;
  margin: 23rpx 0;
  color: #35432d;
  font-size: 29rpx;
}
.invitation-back {
  margin-top: 38rpx !important;
}
