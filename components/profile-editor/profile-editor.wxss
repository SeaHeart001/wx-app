@import "../../styles/theme.wxss";
.panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 70;
  display: flex;
  flex-direction: column;
  background: #faf8f4;
  transform: translateX(100%);
  transition: transform 240ms ease;
}
.panel-open {
  transform: translateX(0);
}
.panel-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
  padding-left: 38rpx;
  padding-right: 220rpx;
  box-sizing: border-box;
}
.panel-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #302e29;
}
.panel-back {
  width: 32rpx !important;
  padding: 0 8rpx 6rpx 0;
  margin: 0;
  background: transparent;
  font-size: 48rpx;
  line-height: 1;
}
.panel-back::after,
.avatar::after,
.gender-option::after,
.text-button::after {
  border: 0;
}
.panel-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}
.panel-body {
  padding: 31rpx 46rpx calc(46rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.avatar-block {
  display: flex;
  align-items: center;
  gap: 31rpx;
}
.avatar-block .avatar {
  width: 123rpx !important;
  padding: 0;
  margin: 0;
  line-height: 1;
}
.avatar-hint {
  color: #687a53;
  font-size: 27rpx;
  font-weight: 700;
}
.profile-fields {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 74rpx;
}
.field-label {
  color: #8a867d;
  font-size: 27rpx;
  flex: 0 0 auto;
}
.field-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  color: #302e29;
  font-size: 27rpx;
  text-align: right;
}
.field-value {
  color: #302e29;
  font-size: 27rpx;
  text-align: right;
}
.gender-field {
  align-items: flex-start;
  padding: 12rpx 0;
}
.gender-row {
  display: flex;
  gap: 12rpx;
}
.gender-option {
  width: auto !important;
  margin: 0;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #faf8f4;
  color: #8a867d;
  font-size: 25rpx;
  line-height: 1.5;
}
.gender-option-active {
  background: #e9eddf;
  color: #35432d;
  font-weight: 700;
}
.save-button {
  margin-top: 38rpx !important;
}
.panel-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.panel-footer .text-button {
  width: auto !important;
}
.logout-button {
  color: #8a867d;
}
