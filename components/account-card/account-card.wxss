@import "../../styles/theme.wxss";
.profile-card {
  padding: 38rpx;
  border-radius: 46rpx;
  background: #fff;
}
.profile-row {
  display: flex;
  align-items: center;
  gap: 31rpx;
  margin-bottom: 23rpx;
}
.profile-row .avatar {
  width: 123rpx !important;
  margin: 0;
  padding: 0;
  line-height: 1;
}
.profile-row .avatar::after {
  border: 0;
}
.profile-meta {
  flex: 1;
  min-width: 0;
}
.profile-name {
  display: block;
  color: #302e29;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
}
.profile-meta .copy {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.profile-details {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 23rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #8a867d;
}
.profile-id {
  word-break: break-all;
}
