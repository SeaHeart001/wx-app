<view class="profile-card">
  <view class="profile-row">
    <button class="avatar" bindtap="handleAvatarTap" aria-label="编辑个人资料">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{displayInitial}}</text>
    </button>
    <view class="profile-meta">
      <text class="profile-name">{{displayName}}</text>
      <text class="copy">{{regionText}}</text>
    </view>
  </view>
  <button class="secondary-button" bindtap="handleAvatarTap">
    {{isLoggedIn ? '编辑个人资料' : '微信一键登录'}}
  </button>
  <view class="profile-details">
    <text>{{loginStatus}} · {{profileStatus}}</text>
    <text class="profile-id">ID · {{memberIdText}}</text>
    <text>更新于 {{updatedAtDisplay}}</text>
  </view>
</view>
