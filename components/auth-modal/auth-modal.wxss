@import "../../styles/theme.wxss";

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 46rpx;
  background: rgba(48, 46, 41, 0.28);
}
.modal {
  width: 100%;
  max-width: 658rpx;
  padding: 46rpx;
  border-radius: 46rpx;
  background: #faf8f4;
  box-sizing: border-box;
}
.modal-title {
  display: block;
  color: #302e29;
  font-size: 42rpx;
  font-weight: 700;
}
.modal-copy {
  display: block;
  margin-top: 23rpx;
  color: #8a867d;
  font-size: 27rpx;
  line-height: 1.6;
}
.modal-primary,
.modal-secondary {
  margin: 30rpx 0 0;
  padding: 22rpx;
  min-height: 100rpx;
  width: 100% !important;
  border-radius: 31rpx;
  box-sizing: border-box;
  font-size: 29rpx;
  text-align: center;
  line-height: 1.5;
}
.modal-primary {
  background: #687a53;
  color: #fff;
}
.modal-secondary {
  background: #e9eddf;
  color: #35432d;
}
.modal-primary::after,
.modal-secondary::after {
  border: 0;
}
