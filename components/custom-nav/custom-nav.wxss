.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  box-sizing: border-box;
  padding-left: 38rpx;
  padding-right: 220rpx;
  background: #faf8f4;
}
.nav-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.nav-title {
  color: #302e29;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.5;
}
.nav-back {
  width: 32rpx !important;
  margin: 0;
  padding: 0 8rpx 6rpx 0;
  background: transparent;
  font-size: 48rpx;
  line-height: 1;
}
.nav-back::after,
.nav-avatar::after {
  border: 0;
}
.nav-avatar {
  margin: 0;
  padding: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e9eddf;
  overflow: hidden;
}
.nav-avatar-image,
.nav-avatar-initial {
  width: 56rpx;
  height: 56rpx;
}
.nav-avatar-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #687a53;
  font-size: 24rpx;
}
