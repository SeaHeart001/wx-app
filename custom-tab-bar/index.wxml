<view wx:if="{{!hidden}}" class="tab-bar">
  <button
    wx:for="{{list}}"
    wx:key="path"
    class="tab-item {{selected === index ? 'tab-selected' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    aria-label="{{item.text}}"
  >
    <image
      class="tab-icon {{selected === index && index === 2 ? 'user-selected' : ''}}"
      src="/assets/icons/{{selected === index ? item.activeIcon : item.icon}}.svg"
    />
    <text>{{item.text}}</text>
  </button>
</view>
